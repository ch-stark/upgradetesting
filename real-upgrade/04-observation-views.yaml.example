apiVersion: view.open-cluster-management.io/v1beta1
kind: ManagedClusterView
metadata:
  name: upgradetesting-version
  namespace: REPLACE_MANAGED_CLUSTER_NAME
spec:
  scope:
    resource: clusterversions.config.openshift.io
    updateIntervalSeconds: 15
    name: version
---
apiVersion: view.open-cluster-management.io/v1beta1
kind: ManagedClusterView
metadata:
  name: upgradetesting-operators
  namespace: REPLACE_MANAGED_CLUSTER_NAME
spec:
  scope:
    resource: clusteroperators.config.openshift.io
    updateIntervalSeconds: 15
---
apiVersion: view.open-cluster-management.io/v1beta1
kind: ManagedClusterView
metadata:
  name: upgradetesting-pools
  namespace: REPLACE_MANAGED_CLUSTER_NAME
spec:
  scope:
    resource: machineconfigpools.machineconfiguration.openshift.io
    updateIntervalSeconds: 15
