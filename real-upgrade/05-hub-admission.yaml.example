apiVersion: v1
kind: ConfigMap
metadata:
  name: live-upgrade-approval
  namespace: upgradetesting
data:
  clusterName: REPLACE_MANAGED_CLUSTER_NAME
  targetVersion: REPLACE_TARGET_VERSION
  prechecksReviewed: 'false'
  windowApproved: 'false'
---
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: live-upgrade-admission
  namespace: policies
spec:
  disabled: false
  remediationAction: inform
  policy-templates:
  - ignorePending: false
    objectDefinition:
      apiVersion: policy.open-cluster-management.io/v1
      kind: ConfigurationPolicy
      metadata:
        name: live-upgrade-approval-check
      spec:
        remediationAction: inform
        severity: high
        evaluationInterval:
          compliant: 10s
          noncompliant: 10s
        object-templates:
        - complianceType: musthave
          objectDefinition:
            apiVersion: v1
            kind: ConfigMap
            metadata:
              name: live-upgrade-approval
              namespace: upgradetesting
            data:
              clusterName: REPLACE_MANAGED_CLUSTER_NAME
              targetVersion: REPLACE_TARGET_VERSION
              prechecksReviewed: 'true'
              windowApproved: 'true'
  - ignorePending: false
    objectDefinition:
      apiVersion: policy.open-cluster-management.io/v1
      kind: ConfigurationPolicy
      metadata:
        name: live-upgrade-reported-precheck
      spec:
        remediationAction: inform
        severity: high
        evaluationInterval:
          compliant: 10s
          noncompliant: 10s
        object-templates:
        - complianceType: musthave
          objectDefinition:
            apiVersion: policy.open-cluster-management.io/v1
            kind: Policy
            metadata:
              name: live-precheck
              namespace: policies
            spec:
              disabled: false
              remediationAction: inform
            status:
              status:
              - clustername: REPLACE_MANAGED_CLUSTER_NAME
                clusternamespace: REPLACE_MANAGED_CLUSTER_NAME
                compliant: Compliant
        - complianceType: musthave
          objectDefinition:
            apiVersion: cluster.open-cluster-management.io/v1
            kind: ManagedCluster
            metadata:
              name: REPLACE_MANAGED_CLUSTER_NAME
            status:
              conditions:
              - type: ManagedClusterConditionAvailable
                status: 'True'
              - type: ManagedClusterJoined
                status: 'True'
    extraDependencies:
    - apiVersion: policy.open-cluster-management.io/v1
      kind: ConfigurationPolicy
      name: live-upgrade-approval-check
      compliance: Compliant
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: live-admission-on-hub
  namespace: policies
placementRef:
  apiGroup: cluster.open-cluster-management.io
  kind: Placement
  name: live-trigger-on-hub
subjects:
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-upgrade-admission
