apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: live-test-spoke
  namespace: upgradetesting-live
spec:
  numberOfClusters: 1
  predicates:
  - requiredClusterSelector:
      labelSelector:
        matchLabels:
          name: REPLACE_MANAGED_CLUSTER_NAME
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: live-test-spoke-health
  namespace: upgradetesting-live
placementRef:
  apiGroup: cluster.open-cluster-management.io
  kind: Placement
  name: live-test-spoke
subjects:
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-precheck
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-progress-safety
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-completion
