apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: live-upgrade-selected
  namespace: policies
spec:
  predicates:
  - requiredClusterSelector:
      labelSelector:
        matchLabels:
          shouldupgrade: 'true'
        matchExpressions:
        - key: local-cluster
          operator: NotIn
          values:
          - 'true'
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: live-upgrade-selected
  namespace: policies
placementRef:
  apiGroup: cluster.open-cluster-management.io
  kind: Placement
  name: live-upgrade-selected
subjects:
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-precheck
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-progress-safety
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-completion
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-upgrade-channel
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-upgrade-target
- apiGroup: policy.open-cluster-management.io
  kind: Policy
  name: live-upgrade-trigger
