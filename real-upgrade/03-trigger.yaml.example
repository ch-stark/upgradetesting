apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: live-upgrade-trigger
  namespace: policies
spec:
  disabled: true
  remediationAction: enforce
  policy-templates:
  - ignorePending: false
    objectDefinition:
      apiVersion: policy.open-cluster-management.io/v1
      kind: ConfigurationPolicy
      metadata:
        name: live-upgrade-trigger-check
      spec:
        remediationAction: enforce
        severity: high
        pruneObjectBehavior: None
        evaluationInterval:
          compliant: 30s
          noncompliant: 10s
        object-templates:
        - complianceType: musthave
          objectDefinition:
            apiVersion: config.openshift.io/v1
            kind: ClusterVersion
            metadata:
              name: version
            spec:
              desiredUpdate:
                version: REPLACE_TARGET_VERSION
                image: REPLACE_APPROVED_RELEASE_IMAGE
                force: false
  dependencies:
  - apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    namespace: policies
    name: live-precheck
    compliance: Compliant
  - apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    namespace: policies
    name: live-upgrade-channel
    compliance: Compliant
  - apiVersion: policy.open-cluster-management.io/v1
    kind: Policy
    namespace: policies
    name: live-upgrade-target
    compliance: Compliant
